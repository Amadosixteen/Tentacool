# ─────────────────────────────────────────────────────────────────────
#  Plantilla de configuración — cópiala a `.env` y rellena tus valores.
#     cp .env.example .env
#
#  Todas las claves son OPCIONALES: si dejas una vacía, ese nodo se
#  omite con un aviso y el resto sigue funcionando.
# ─────────────────────────────────────────────────────────────────────

# ── LLM (el briefing de la mañana) ─────────────────────────────────
# Por defecto DeepSeek. Para otro proveedor compatible con OpenAI API:
#   LLM_API_KEY=sk-...
#   LLM_BASE_URL=https://api.deepseek.com   (o el endpoint de tu proveedor)
#   LLM_MODEL=deepseek-chat                 (o el modelo que uses)
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# (Alias compatible: DEEPSEEK_API_KEY=sk-...)

# ── GitHub (últimos commits desde ayer de TODOS tus repos) ──────────
GITHUB_TOKEN=
GITHUB_USER=

# ── Notion (página libre "Memoria" — contexto diario) ──────────────
NOTION_TOKEN=
# ID de la página (no de una base de datos). Puedes pegar el ID de la URL.
NOTION_DATABASE_ID=
# URL canónica de la página (la que abre en el navegador). Opcional.
NOTION_PAGE_URL=

# ── Notion (página libre "Anotaciones" — recursos del día a día) ────
# Bitácora aparte para enlaces, credenciales y datos a mano. Cada entrada
# se guarda con día, fecha, hora exacta y el proyecto desde el que se
# anotó. IMPORTANTE: esta página NUNCA se lee hacia el LLM — solo se
# consulta bajo petición (CLI `anotaciones` o herramienta MCP), para que
# lo que guardes aquí no acabe en el prompt del briefing.
# Recuerda compartir la página con tu integración de Notion:
#   la página → ••• → Connections → añade tu integración
NOTION_ANOTACIONES_PAGE_ID=

# ── Navegador (abrir WhatsApp, Gmail y Notion cada mañana) ─────────
BROWSER_CMD=brave-browser
BROWSER_PROFILE=Default
WHATSAPP_URL=https://web.whatsapp.com
GMAIL_URL=https://mail.google.com

# ── Proyectos locales (Docker y VS Code) ───────────────────────────
PROJECTS_DIR=~/Projects
# Lista separada por comas de carpetas con docker-compose
PROJECTS_DOCKER=
# Proyecto a abrir en VS Code
VSCODE_PROJECT=

# ── Feature flags (activa/desactiva integraciones) ─────────────────
DOCKER_ENABLED=false
BROWSER_ENABLED=true
VSCODE_ENABLED=true

# ── Zona horaria ───────────────────────────────────────────────────
# Zona usada para las fechas del reporte en Notion y la que se le pasa
# al LLM. Se fija aquí porque bajo cron la TZ del sistema puede no
# heredarse. Formato IANA (ej. America/Lima, Europe/Madrid).
TENTACOOL_TZ=America/Lima

# ── CLI de Go (I/O concurrente) ────────────────────────────────────
# Ruta al binario tentacool-io (default: buscarlo en el PATH).
# Si no existe, los nodos usan el fallback en Python.
TENTACOOL_IO_BIN=tentacool-io

# ─────────────────────────────────────────────────────────────────────
#  ⏰ PROGRAMACIÓN (cuándo se dispara)
#  La hora de disparo NO se configura aquí: se define con CRON, a la
#  hora y días que quieras. Ejemplo (lun-vie 8:00), ajustando la ruta:
#
#    crontab -e
#    0 8 * * 1-5 DISPLAY=:0 /ruta/tentacool/.venv/bin/python \
#      /ruta/tentacool/main.py inicio >> /ruta/tentacool/cron-inicio.log 2>&1
#
#  Cambia `0 8 * * 1-5` por la hora/días que quieras (ej. `30 9 * * *`).
#  Verifica con: crontab -l
# ─────────────────────────────────────────────────────────────────────
