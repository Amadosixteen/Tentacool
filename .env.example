# ─────────────────────────────────────────────────────────────────────
#  Plantilla de configuración — cópiala a `.env` y rellena tus valores.
#     cp .env.example .env
#
#  Todas las claves son OPCIONALES: si dejas una vacía, ese nodo se
#  omite con un aviso y el resto sigue funcionando.
# ─────────────────────────────────────────────────────────────────────

# ── LLM (el briefing de la mañana) ─────────────────────────────────
# Por defecto DeepSeek. Para otro proveedor compatible con OpenAI API:
#   LLM_API_KEY=sk-...
#   LLM_BASE_URL=https://api.deepseek.com   (o el endpoint de tu proveedor)
#   LLM_MODEL=deepseek-chat                 (o el modelo que uses)
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# (Alias compatible: DEEPSEEK_API_KEY=sk-...)

# ── GitHub (últimos commits desde ayer de TODOS tus repos) ──────────
GITHUB_TOKEN=
GITHUB_USER=

# ── Notion (página libre "Memoria" — contexto diario) ──────────────
NOTION_TOKEN=
# ID de la página (no de una base de datos). Puedes pegar el ID de la URL.
NOTION_DATABASE_ID=
# URL canónica de la página (la que abre en el navegador). Opcional.
NOTION_PAGE_URL=

# ── Navegador (abrir WhatsApp, Gmail y Notion cada mañana) ─────────
BROWSER_CMD=brave-browser
BROWSER_PROFILE=Default
WHATSAPP_URL=https://web.whatsapp.com
GMAIL_URL=https://mail.google.com

# ── Proyectos locales (Docker y VS Code) ───────────────────────────
PROJECTS_DIR=~/Projects
# Lista separada por comas de carpetas con docker-compose
PROJECTS_DOCKER=
# Proyecto a abrir en VS Code
VSCODE_PROJECT=

# ── Feature flags (activa/desactiva integraciones) ─────────────────
DOCKER_ENABLED=false
BROWSER_ENABLED=true
VSCODE_ENABLED=true
